# Address of the backend when the website and the backend are hosted
# separately (Vercel + Railway). Leave empty for local development.
# No trailing slash, no /api.
VITE_API_URL=https://your-backend.up.railway.app

# Local development only (npm run dev): where your backend runs.
# VITE_DEV_API=http://localhost:5000

# Optional, `npm run dev` only: extra hostnames the dev server should accept
# (comma separated), for example when previewing through a shared dev domain.
# VITE_ALLOWED_HOSTS=dev.example.com
