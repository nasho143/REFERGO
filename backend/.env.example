# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Long random text. Required when NODE_ENV=production.
JWT_SECRET=change-this-to-a-long-random-text

# ---------- Database (local) ----------
# On Railway these are filled in for you (MYSQLHOST, MYSQLPORT, ...).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=refergo

# ---------- Website address(es) allowed to call this backend ----------
# Your Vercel address. Several can be listed, separated by commas.
FRONTEND_URL=https://your-app.vercel.app

# ---------- Email for "Forgot password" ----------
# On Railway use Brevo (or Resend): Railway blocks SMTP on its Free/Hobby plans.
#
# Option A - Brevo (works with any verified sender email, no domain needed)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=REFERGO - PESO Mendez
#
# Option B - Resend (needs a verified domain to email other people)
RESEND_API_KEY=
MAIL_FROM=
#
# Option C - SMTP such as Gmail (works on your own computer, not on Railway Hobby)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
